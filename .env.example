# =========================================
# Backend Deployment Environment Variables
# =========================================

# Secret key for sessions & security
SECRET_KEY=academic-coordinator-secret-key-2026-secure

# Production Database (Optional)
# If omitted, defaults to SQLite local database file.
# For persistent data across FastAPI Cloud restarts/scaling, use PostgreSQL
# (e.g., Supabase, Neon, Neon Postgres, Railway, etc.):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Academic Attendance Compliance Thresholds
LATE_GRACE_PERIOD_MINUTES=10
EARLY_DISCONNECT_GRACE_MINUTES=10
MIN_ATTENDANCE_PCT_FOR_CREDIT=75.0
MAX_UNEXCUSED_ABSENCE_THRESHOLD=3
